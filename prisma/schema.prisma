datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  MASTER_ADMIN
  INVESTOR
}

enum ExpenseStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AssetType {
  PHOTO
  VIDEO
  TEXT
}

enum ExplicitLevel {
  TEASER
  SOFT
  PPV
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

enum TxStatus {
  PENDING   // Innerhalb der 21-Tage-Sperrfrist
  MATURED   // Auszahlbar nach 21 Tagen
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String?           // Can be null until user finishes registration via key
  name            String?
  role            Role              @default(INVESTOR)
  registrationKey String?           @unique // Required registration key generated by Master Admin
  isRegistered    Boolean           @default(false)
  isActive        Boolean           @default(true)  // Master Admin can suspend/restrict access
  lastLoginAt     DateTime?
  tonAddress      String?           // Public Address for 50/50 & recoupment payouts
  createdAt       DateTime          @default(now())

  assignedModels    Model[]           @relation("InvestorModels")
  submittedExpenses Expense[]
  activityLogs      UserActivityLog[]
}

model UserActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "LOGIN", "LOGOUT", "SUBMIT_EXPENSE", "VIEW_CHANNEL"
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Model {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  telegramChannelId String            @unique
  channelTitle      String?
  avatarUrl         String?
  openInvestBalance Float             @default(0.0) // Offene Investitionen, die getilgt werden müssen ($)
  createdAt         DateTime          @default(now())

  // Assigned Investor (Channel-specific investor)
  investorId              String?
  investor                User?             @relation("InvestorModels", fields: [investorId], references: [id])
  investorSharePercent    Float             @default(50.0) // Individueller Investor-Gewinnanteil in % nach Amortisation (z.B. 50, 60, 70)
  enableExpenseRecoupment Boolean           @default(true) // Ob Investitionsbelege vorab amortisiert werden (true) oder Direkt-Split ohne Amortisation gilt (false)

  assets            Asset[]
  posts             Post[]
  expenses          Expense[]
  starTransactions  StarTransaction[]
  payouts           Payout[]
}

model Asset {
  id            String        @id @default(uuid())
  modelId       String
  model         Model         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  title         String?       // e.g. "Strand Bikini Set 01", "Lingerie Clip HD"
  theme         String?       // e.g. "Beach & Sun", "Lingerie / Boudoir", "VIP Exclusive", "Gym / Fitness"
  notes         String?       // Content hints for Grok AI (e.g. "red dress, flirty look, evening lighting")
  fileUrl       String?       // Optional reference link or external storage path (no upload required)
  type          AssetType     @default(PHOTO) // PHOTO, VIDEO, TEXT
  explicitLevel ExplicitLevel @default(TEASER) // TEASER (0 Stars), SOFT (0-25 Stars), PPV (50-500 Stars)
  tags          String[]
  isUsed        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  posts         Post[]
}

model Post {
  id            String      @id @default(uuid())
  modelId       String
  model         Model       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  assetId       String?
  asset         Asset?      @relation(fields: [assetId], references: [id])
  caption       String
  starsPrice    Int         @default(0) // 0 = Free, > 0 = Paid Media Paywall
  scheduledFor  DateTime
  status        PostStatus  @default(DRAFT)
  telegramMsgId String?
  createdAt     DateTime    @default(now())
}

model Expense {
  id            String        @id @default(uuid())
  modelId       String
  model         Model         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  description   String
  amountUsd     Float
  receiptUrl    String?
  status        ExpenseStatus @default(PENDING_REVIEW) // PENDING_REVIEW -> APPROVED -> REJECTED
  
  // Investor who submitted the expense
  submittedById String?
  submittedBy   User?         @relation(fields: [submittedById], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?

  createdAt     DateTime      @default(now())
}

model StarTransaction {
  id              String   @id @default(uuid())
  modelId         String
  model           Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  telegramTxId    String   @unique
  starsAmount     Int
  estimatedUsd    Float
  transactionDate DateTime
  maturesAt       DateTime // transactionDate + 21 Tage
  status          TxStatus @default(PENDING)
  createdAt       DateTime @default(now())
}

model Payout {
  id          String   @id @default(uuid())
  modelId     String
  model       Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  amountTon   Float
  amountUsd   Float
  txHash      String   @unique
  recipient   String
  paidAt      DateTime @default(now())
}
