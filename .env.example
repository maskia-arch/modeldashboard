# Database & Cache
DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/model_dashboard?schema=public"
REDIS_URL="redis://localhost:6379"

# Master Admin Credentials (authoritative master login configured via ENV)
MASTER_ADMIN_EMAIL="admin@autoacts.link"
MASTER_ADMIN_PASSWORD="ChangeMe_MasterAdmin2025!"

# Application Security
NEXTAUTH_SECRET="super-secret-random-key-32-chars-minimum-autoacts"
NEXTAUTH_URL="https://model.autoacts.link"
JWT_SECRET="super-secret-jwt-key-autoacts-models"

# Telegram Bot API (for posting and notifications)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"

# Telegram MTProto (GramJS Client - from owner/admin account)
# Obtain API_ID & API_HASH from https://my.telegram.org/apps
TELEGRAM_API_ID="12345678"
TELEGRAM_API_HASH="your_telegram_api_hash_here"
# Generate session string via `npm run telegram:login`
TELEGRAM_SESSION_STRING="your_gramjs_string_session_here"

# xAI Grok API
XAI_API_KEY="xai-your-api-key-here"
XAI_MODEL="grok-beta"

# TON Blockchain & Payments
# TonCenter API or TonAPI endpoint for transaction validation
TON_API_ENDPOINT="https://toncenter.com/api/v2/jsonRPC"
TON_API_KEY=""
# Default Star to USD conversion rate (approx $0.013 - $0.015 per Star)
STAR_USD_RATE="0.013"

# Node Environment
NODE_ENV="development"
PORT=3000
